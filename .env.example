# Base de datos local (usa prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Producción PostgreSQL (usa prisma/schema.postgresql.prisma)
# DATABASE_URL="postgresql://wilo:CONTRASENA@127.0.0.1:5432/wilo_studio?schema=public"

# Aplicación y autenticación
SITE_URL="https://wilostudio.site"
NEXTAUTH_URL="https://wilostudio.site"
NEXTAUTH_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
LICENSE_ENCRYPTION_KEY=""
WHATSAPP_NUMBER="51936617557"

# Archivos persistentes. En desarrollo pueden ser rutas relativas al proyecto.
# En producción usa rutas absolutas fuera de cada release, por ejemplo /var/lib/wilostudio/...
MEDIA_UPLOAD_ROOT="./public/uploads"
PRIVATE_STORAGE_ROOT="./storage"

# Correo transaccional
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_TO=""

# Mercado Pago (proveedor online implementado)
MP_PUBLIC_KEY=""
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# Culqi (reservado para cambiar de proveedor)
CULQI_PUBLIC_KEY=""
CULQI_SECRET_KEY=""
